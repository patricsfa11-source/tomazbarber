{
  // Exclusivo dos testes locais. Não publicar esta configuração.
  "name": "tomazbarber-e2e",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tomazbarber-dev",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "CUSTOMER_AUTH_SECRET": "segredo-ficticio-de-verificacao-exclusivo-e2e-123",
    "WHATSAPP_MODE": "test",
    "WHATSAPP_TEST_RECIPIENT": "+5575999990500",
    "WHATSAPP_ENABLED_SINCE": "2020-01-01T00:00:00Z",
    "WHATSAPP_PUBLIC_BASE_URL": "https://tomaz-ficticio.test",
    "WHATSAPP_GRAPH_VERSION": "v27.0",
    "WHATSAPP_PHONE_NUMBER_ID": "111111111111",
    "WHATSAPP_WABA_ID": "222222222222",
    "WHATSAPP_ACCESS_TOKEN": "token-ficticio-exclusivo-e2e",
    "WHATSAPP_APP_SECRET": "app-secret-ficticio-exclusivo-e2e-123",
    "WHATSAPP_PAYLOAD_SECRET": "payload-secret-ficticio-exclusivo-e2e-123",
    "WHATSAPP_VERIFY_TOKEN": "verify-token-ficticio-exclusivo-e2e-123",
  },
  "services": [
    { "binding": "VERIFICATION_SENDER", "service": "tomaz-whatsapp-simulado" },
    { "binding": "WHATSAPP_HTTP", "service": "tomaz-whatsapp-simulado" },
  ],
}
